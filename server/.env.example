# Daily Bloom API — server environment variables
# Copy this file to .env and fill in your values. Never commit .env!

# PostgreSQL connection string
DATABASE_URL=postgresql://bloom:bloom@localhost:5433/bloom

# Firebase Admin SDK
# Option A: Path to your downloaded service account JSON file
GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json

# Option B: Paste the entire service account JSON as a single-line string
# (Recommended for cloud hosting like Render / Railway / Fly.io)
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}

# Server port (optional, defaults to 8080)
PORT=8080
NODE_ENV=development

# AI proxy — Gemini 2.5 Flash-Lite primary, Groq fallback.
# Leave both empty for $0 local-heuristic mode (dev/offline still works).
# GEMINI_API_KEY from https://aistudio.google.com/apikey (free tier)
GEMINI_API_KEY=
# GROQ_API_KEY from https://console.groq.com (free tier, OpenAI-compatible)
GROQ_API_KEY=
# Max AI calls per user per day; over cap returns local heuristics (no 429).
AI_DAILY_CAP=50

# Crash reporting (Sentry). Empty = disabled, nothing leaves the server.
# SENTRY_DSN=

# Web origins for CORS (comma-separated). Native apps send no Origin and
# always pass; browsers are restricted to this list in production.
# CORS_ORIGIN=http://localhost:3000,https://yourdomain.com
