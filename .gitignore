# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Node backend (never push these to GitHub)
server/node_modules/
server/.env
server/firebase-service-account.json
server/*.log
server/*.err
server/*.txt
server/npm_test_full.log
server/run-*.log
server/server*.log

# Local test / debug output (never commit triage logs)
test_out*.txt
full_out.txt
ci.yml.txt
tool/audit_out.txt

# Firebase credentials — NEVER commit these
google-services.json
GoogleService-Info.plist
lib/firebase_options.dart

# Android release signing (the .jks + passwords must never be committed)
android/key.properties
*.jks
*.keystore
