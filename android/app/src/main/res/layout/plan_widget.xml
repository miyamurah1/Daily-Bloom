<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="8dp"
    android:orientation="vertical"
    android:background="@drawable/plan_widget_bg"
    android:padding="12dp"
    android:id="@+id/widget_container">

    <TextView
        android:id="@+id/plan_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Today's plan"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.12"
        android:textColor="#E84A6B" />

    <!-- Streak + progress line ("Day 12 · 2 done · 3 open") — hidden
         until Dart pushes a non-empty widget_stats string. -->
    <TextView
        android:id="@+id/plan_stats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="2dp"
        android:textSize="11sp"
        android:textColor="#A79FC4"
        android:maxLines="1"
        android:ellipsize="end"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/plan_row_0"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="6dp">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/plan_title_0"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#F2EFFA"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="1. Prepare demo slides" />
            <TextView
                android:id="@+id/plan_reason_0"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="#A79FC4"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="due soon" />
        </LinearLayout>
        <!-- One-tap completion: done straight from the launcher. -->
        <TextView
            android:id="@+id/plan_check_0"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:paddingEnd="2dp"
            android:textSize="18sp"
            android:textColor="#E84A6B"
            tools:text="✓" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/plan_row_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="6dp">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/plan_title_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#F2EFFA"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="2. Grocery run" />
            <TextView
                android:id="@+id/plan_reason_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="#A79FC4"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="small win" />
        </LinearLayout>
        <TextView
            android:id="@+id/plan_check_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:paddingEnd="2dp"
            android:textSize="18sp"
            android:textColor="#E84A6B"
            tools:text="✓" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/plan_row_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="6dp">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/plan_title_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#F2EFFA"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="3. Morning run" />
            <TextView
                android:id="@+id/plan_reason_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="#A79FC4"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="already started" />
        </LinearLayout>
        <TextView
            android:id="@+id/plan_check_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:paddingEnd="2dp"
            android:textSize="18sp"
            android:textColor="#E84A6B"
            tools:text="✓" />
    </LinearLayout>

    <TextView
        android:id="@+id/plan_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="6dp"
        android:textSize="13sp"
        android:textColor="#A79FC4"
        android:text="No plan yet — open Bloom to plan." />
</LinearLayout>
