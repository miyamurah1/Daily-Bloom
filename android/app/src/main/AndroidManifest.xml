<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Network: Firebase Auth, backend sync, Google sign-in. Declared
         explicitly (normal permission, Play-safe) instead of relying on
         the INTERNET entry merged in from google_sign_in_android. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Voice capture (quick-add mic). Requested at first use, not install. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Focus-timer expiry alarm: exact timing when granted (Android 12+),
         graceful inexact fallback otherwise. Requested at timer start.
         (USE_EXACT_ALARM deliberately NOT declared — Play reserves it
         for clock/calendar apps; SCHEDULE_EXACT_ALARM is user-grantable.) -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Reboot/update re-scheduling: AlarmManager alarms are dropped on
         reboot (and the plugin can't reschedule without hearing about it).
         Normal install-time permission — no runtime prompt, Play-safe. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <application
        android:label="Daily Bloom"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>

            <!-- Widget taps arrive here with dailybloom:// URIs. -->
            <intent-filter>
                <action android:name="es.antonborri.home_widget.action.LAUNCH" />
            </intent-filter>

            <!-- Share-to-app: text shared from other apps lands in a
                 prefilled quick-add (receive_sharing_intent). -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Today's-plan home-screen widget (RemoteViews, pushed from Dart). -->
        <receiver android:name=".PlanWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/plan_widget_info" />
        </receiver>
        <!-- flutter_local_notifications: REQUIRED manifest receivers (their
             own manifest declares neither). Without these, AlarmManager's
             broadcast has no target and scheduled notifications (daily
             nudge, weekly review, focus expiry) never display — plus
             reminders don't survive reboot/app update. Verbatim from the
             plugin README setup section. -->
        <receiver android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver" />
        <!-- Notification ACTION buttons ("Done ✓", "Plant 🌱") and the
             dismiss/delete intent are delivered as broadcasts to this
             receiver; without it the buttons render but do nothing. -->
        <receiver android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ActionBroadcastReceiver" />
        <receiver android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
